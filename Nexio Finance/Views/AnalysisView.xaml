<UserControl x:Class="NexioFinance.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:Nexio_Finance.Properties"
             Background="#F3F4F6" SizeChanged="UserControl_SizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. HLAVNÍ FILTRY -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,14" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static properties:Resources.AnalysisMonth}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,8,0"/>
                    <ComboBox x:Name="MonthComboBox" Width="110" Padding="6" Margin="0,0,24,0" SelectionChanged="Filter_SelectionChanged"/>

                    <TextBlock Text="{x:Static properties:Resources.AnalysisYear}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,8,0"/>
                    <ComboBox x:Name="YearComboBox" Width="100" Padding="6" Margin="0,0,24,0" SelectionChanged="Filter_SelectionChanged"/>

                    <TextBlock Text="{x:Static properties:Resources.AnalysisCurrency}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CurrencyComboBox" Width="90" Padding="6" SelectionChanged="Filter_SelectionChanged" DisplayMemberPath="Code" SelectedValuePath="Code"/>
                </StackPanel>
            </Border>

            <!-- 2. SOUHRNNÉ KARTY -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.AnalysisIncome}" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalIncomeText" Text="0,00" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" Margin="10,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.AnalysisExpense}" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalExpenseText" Text="0,00" FontSize="24" FontWeight="Bold" Foreground="#EF4444" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20" Margin="10,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.AnalysisSavings}" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SavingsText" Text="0,00" FontSize="24" FontWeight="Bold" Foreground="#3B82F6" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. KOLÁČOVÉ GRAFY -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.AnalysisIncomeSource}" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Canvas x:Name="IncomePieCanvas" Width="180" Height="180" HorizontalAlignment="Left"/>
                            <StackPanel x:Name="IncomeLegend" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" Margin="10,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.AnalysisExpenseDest}" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Canvas x:Name="ExpensePieCanvas" Width="180" Height="180" HorizontalAlignment="Left"/>
                            <StackPanel x:Name="ExpenseLegend" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. SLOUPCOVÝ GRAF VÝDAJŮ -->
            <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock x:Name="BarChartTitle" Text="{x:Static properties:Resources.AnalysisExpenseDetail}" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center"/>
                        <Button x:Name="BackButton" Content="{x:Static properties:Resources.AnalysisBackToMain}" Background="Transparent" Foreground="#3B82F6" FontWeight="SemiBold" BorderThickness="0" Margin="20,0,0,0" Visibility="Collapsed" Click="BackButton_Click"/>
                    </StackPanel>

                    <Canvas x:Name="ExpenseBarCanvas" Grid.Row="1" Height="230" Margin="10,20,10,10"/>
                </Grid>
            </Border>

            <!-- 5. VÝVOJ PŘÍJMŮ -->
            <Border Grid.Row="4" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{x:Static properties:Resources.AnalysisIncomeTrend}" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,15"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Canvas x:Name="IncomeTrendCanvas" Height="200" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 6. GRAF: VÝVOJ CELKOVÉHO ZŮSTATKU -->
            <Border Grid.Row="5" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Hlavička s ovládacími prvky -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="{x:Static properties:Resources.BalanceTrendTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Účet:" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" Margin="0,0,6,0"/>
                            <ComboBox x:Name="BalanceAccountFilter" Width="130" Padding="5" Margin="0,0,16,0" SelectionChanged="BalanceFilter_SelectionChanged"/>

                            <TextBlock Text="Období:" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" Margin="0,0,6,0"/>
                            <ComboBox x:Name="BalanceRangeFilter" Width="130" Padding="5" Margin="0,0,16,0" SelectionChanged="BalanceFilter_SelectionChanged"/>

                            <TextBlock Text="Detail:" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" Margin="0,0,6,0"/>
                            <ComboBox x:Name="BalanceGranularityFilter" Width="110" Padding="5" SelectionChanged="BalanceFilter_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Samotné plátno grafu -->
                    <Canvas x:Name="BalanceTrendCanvas" Grid.Row="1" Height="260" Margin="10,10,10,30" Loaded="BalanceTrendCanvas_Loaded"/>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>