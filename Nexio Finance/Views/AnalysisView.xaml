<UserControl x:Class="NexioFinance.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:Nexio_Finance.Properties"
             Background="#F1F5F9" SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>
        <!-- Jemný stín pro karty -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Color="#0F172A" Opacity="0.04"/>
        <DropShadowEffect x:Key="PopupShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Color="#0F172A" Opacity="0.12"/>

        <!-- Styl pro moderní kartu -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- Moderní ToggleButton pro ComboBox -->
        <ControlTemplate x:Key="ModernComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0" Stroke="#64748B" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#CBD5E1"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="#3B82F6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Moderní ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Moderní ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ModernComboBoxToggleButton}"
                                          Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,3,28,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#FFFFFF" BorderThickness="1" BorderBrush="#E2E8F0"
                                            CornerRadius="10" Padding="4" Margin="0,0,0,8" Effect="{StaticResource PopupShadow}">
                                        <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Moderní navigační tlačítko (šipky období / akce) -->
        <Style x:Key="IconNavButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#BFDBFE"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tenký moderní horizontální ScrollBar -->
        <Style x:Key="SlimScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBd" Background="#CBD5E1" CornerRadius="4" Height="6" Margin="0,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimHorizontalScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="MinHeight" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#F8FAFC" Height="10">
                            <Border CornerRadius="4" Background="#F1F5F9" Margin="2"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20,24,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. HLAVNÍ HLAVIČKA A FILTRY -->
            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Padding="20,14" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Titulek sekce s aktivním obdobím -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#EFF6FF" Margin="0,0,12,0">
                            <Path Data="M4,18 L4,12 M10,18 L10,6 M16,18 L16,10 M22,18 L22,4"
                                  Stroke="#2563EB" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="18" Height="18"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ActivePeriodTitle" Text="Finanční analýza" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="ActivePeriodSubtitle" Text="Přehled cashflow, kategorií a vývoje majetku" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Filtry vpravo -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="◀" Style="{StaticResource IconNavButton}" Margin="0,0,8,0" Click="PrevMonthButton_Click" ToolTip="Předchozí měsíc"/>

                        <TextBlock Text="{x:Static properties:Resources.AnalysisMonth}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="4,0,6,0"/>
                        <ComboBox x:Name="MonthComboBox" Width="80" Margin="0,0,14,0" SelectionChanged="Filter_SelectionChanged"/>

                        <TextBlock Text="{x:Static properties:Resources.AnalysisYear}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,6,0"/>
                        <ComboBox x:Name="YearComboBox" Width="96" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged"/>

                        <Button Content="▶" Style="{StaticResource IconNavButton}" Margin="0,0,20,0" Click="NextMonthButton_Click" ToolTip="Další měsíc"/>

                        <Border Width="1" Height="24" Background="#E2E8F0" Margin="0,0,18,0"/>

                        <TextBlock Text="{x:Static properties:Resources.AnalysisCurrency}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CurrencyComboBox" Width="92" SelectionChanged="Filter_SelectionChanged" DisplayMemberPath="Code" SelectedValuePath="Code"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. SOUHRNNÉ KPI KARTY -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Karta: Příjmy -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="22,18" Margin="0,0,9,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#ECFDF5" Margin="0,0,10,0">
                                    <Path Data="M7,17 L17,7 M17,7 L9,7 M17,7 L17,15" Stroke="#10B981" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static properties:Resources.AnalysisIncome}" Foreground="#475569" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border x:Name="IncomeTrendBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#ECFDF5" CornerRadius="6" Padding="8,3">
                                <TextBlock x:Name="IncomeTrendBadgeText" Text="0 %" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="TotalIncomeText" Grid.Row="1" Text="0,00 CZK" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,12,0,6"/>

                        <TextBlock x:Name="IncomeSubText" Grid.Row="2" Text="0 transakcí v tomto měsíci" FontSize="12" Foreground="#64748B"/>
                    </Grid>
                </Border>

                <!-- Karta: Náklady -->
                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Padding="22,18" Margin="9,0,9,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#FEF2F2" Margin="0,0,10,0">
                                    <Path Data="M7,7 L17,17 M17,17 L9,17 M17,17 L17,9" Stroke="#EF4444" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static properties:Resources.AnalysisExpense}" Foreground="#475569" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border x:Name="ExpenseTrendBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FEF2F2" CornerRadius="6" Padding="8,3">
                                <TextBlock x:Name="ExpenseTrendBadgeText" Text="0 %" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="TotalExpenseText" Grid.Row="1" Text="0,00 CZK" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,12,0,6"/>

                        <TextBlock x:Name="ExpenseSubText" Grid.Row="2" Text="Průměrně 0 CZK / den" FontSize="12" Foreground="#64748B"/>
                    </Grid>
                </Border>

                <!-- Karta: Úspory / Bilance -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="22,18" Margin="9,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#EFF6FF" Margin="0,0,10,0">
                                    <Path Data="M4,12 L20,12 M12,4 L12,20" Stroke="#3B82F6" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static properties:Resources.AnalysisSavings}" Foreground="#475569" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border x:Name="SavingsRateBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EFF6FF" CornerRadius="6" Padding="8,3">
                                <TextBlock x:Name="SavingsRateBadgeText" Text="Míra úspor: 0 %" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="SavingsText" Grid.Row="1" Text="0,00 CZK" FontSize="26" FontWeight="Bold" Foreground="#2563EB" Margin="0,12,0,8"/>

                        <!-- Mini progress bar pro míru úspor / vyčerpání příjmů -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="6" Background="#F1F5F9" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Border x:Name="SavingsProgressBar" Height="6" HorizontalAlignment="Left" Width="0" Background="#3B82F6" CornerRadius="3"/>
                            </Border>
                            <TextBlock x:Name="SavingsRatioSubText" Grid.Column="1" Text="0 % příjmů utraceno" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. PRSTENCOVÉ (DONUT) GRAFY S DETAILNÍ LEGENDOU -->
            <Grid Grid.Row="2" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Donut: Příjmy -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="22,20" Margin="0,0,9,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static properties:Resources.AnalysisIncomeSource}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Rozložení příjmů podle hlavních kategorií" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#ECFDF5" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="PŘÍJMY" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="184" Height="184" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas x:Name="IncomePieCanvas" Width="184" Height="184"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" MaxWidth="112">
                                    <TextBlock x:Name="IncomeDonutCenterLabel" Text="CELKEM" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="IncomeDonutCenterValue" Text="0" FontSize="15" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0" TextAlignment="Center"/>
                                    <TextBlock x:Name="IncomeDonutCenterSub" Text="0 kat." FontSize="11" Foreground="#10B981" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="200" Margin="14,0,0,0">
                                <StackPanel x:Name="IncomeLegend" VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Donut: Náklady -->
                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Padding="22,20" Margin="9,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static properties:Resources.AnalysisExpenseDest}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Kliknutím na kategorii zobrazíte podkategorie" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FEF2F2" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="NÁKLADY" FontSize="10" FontWeight="Bold" Foreground="#DC2626"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="184" Height="184" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas x:Name="ExpensePieCanvas" Width="184" Height="184"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" MaxWidth="112">
                                    <TextBlock x:Name="ExpenseDonutCenterLabel" Text="CELKEM" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ExpenseDonutCenterValue" Text="0" FontSize="15" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0" TextAlignment="Center"/>
                                    <TextBlock x:Name="ExpenseDonutCenterSub" Text="0 kat." FontSize="11" Foreground="#EF4444" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="200" Margin="14,0,0,0">
                                <StackPanel x:Name="ExpenseLegend" VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. INTERAKTIVNÍ BREAKDOWN VÝDAJŮ (DRILL-DOWN ŽEBŘÍČEK PŘES CELOU ŠÍŘKU) -->
            <Border Grid.Row="3" Style="{StaticResource ModernCard}" Padding="22,20" Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="BarChartTitle" Text="{x:Static properties:Resources.AnalysisExpenseDetail}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Border x:Name="DrillDownHintBadge" Background="#F1F5F9" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="DrillDownHintText" Text="Klikněte na kategorii pro detail podkategorií" FontSize="11" Foreground="#64748B" FontWeight="Medium"/>
                            </Border>
                        </StackPanel>

                        <Button x:Name="BackButton" Content="{x:Static properties:Resources.AnalysisBackToMain}"
                                HorizontalAlignment="Right" Visibility="Collapsed" Click="BackButton_Click" Cursor="Hand"
                                Padding="12,6" Background="#EFF6FF" Foreground="#2563EB" FontWeight="SemiBold" FontSize="12" BorderThickness="1" BorderBrush="#BFDBFE">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="← " FontWeight="Bold"/>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Kontejner pro responzivní vykreslení kategorií (využívá 100 % šířky) -->
                    <Canvas x:Name="ExpenseBarCanvas" Grid.Row="1" MinHeight="180" Margin="0,4,0,4"/>
                </Grid>
            </Border>

            <!-- 5. VÝVOJ CASHFLOW V ČASE (PŘÍJMY VS. NÁKLADY + ČISTÁ BILANCE) -->
            <Border Grid.Row="4" Style="{StaticResource ModernCard}" Padding="22,20" Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.AnalysisIncomeTrend}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Měsíční srovnání příjmů, výdajů a čistého cashflow (kliknutím na měsíc přepnete detail nahoře)" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Legenda Cashflow grafu -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Příjmy" FontSize="12" FontWeight="Medium" Foreground="#475569" Margin="0,0,16,0" VerticalAlignment="Center"/>

                            <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Náklady" FontSize="12" FontWeight="Medium" Foreground="#475569" Margin="0,0,16,0" VerticalAlignment="Center"/>

                            <Line X1="0" Y1="5" X2="16" Y2="5" Stroke="#3B82F6" StrokeThickness="2.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Čistá bilance" FontSize="12" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="CashflowScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,6">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimHorizontalScrollBar}"/>
                        </ScrollViewer.Resources>
                        <Canvas x:Name="IncomeTrendCanvas" Height="230" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 6. GRAF: VÝVOJ CELKOVÉHO ZŮSTATKU (INTERAKTIVNÍ SPLINE AREA CHART) -->
            <Border Grid.Row="5" Style="{StaticResource ModernCard}" Padding="22,20" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Hlavička s ovládacími prvky -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Static properties:Resources.BalanceTrendTitle}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="BalanceChangeSubText" Text="Průběžný vývoj zůstatku zvolených účtů v čase" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Účet:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,8,0"/>
                            <ComboBox x:Name="BalanceAccountFilter" Width="155" Margin="0,0,16,0" SelectionChanged="BalanceFilter_SelectionChanged"/>

                            <TextBlock Text="Období:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,8,0"/>
                            <ComboBox x:Name="BalanceRangeFilter" Width="145" Margin="0,0,16,0" SelectionChanged="BalanceFilter_SelectionChanged"/>

                            <TextBlock Text="Detail:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,8,0"/>
                            <ComboBox x:Name="BalanceGranularityFilter" Width="125" SelectionChanged="BalanceFilter_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Rychlé statistiky období zůstatku (Počátek / Minimum / Maximum / Konec) -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="POČÁTEČNÍ STAV" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock x:Name="BalanceStartStatText" Text="0,00 CZK" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MINIMUM V OBDOBÍ" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock x:Name="BalanceMinStatText" Text="0,00 CZK" FontSize="14" FontWeight="Bold" Foreground="#EF4444" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MAXIMUM V OBDOBÍ" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock x:Name="BalanceMaxStatText" Text="0,00 CZK" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="KONCOVÝ ZŮSTATEK (ZMĚNA)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock x:Name="BalanceEndStatText" Text="0,00 CZK" FontSize="14" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Samotné plátno grafu -->
                    <Canvas x:Name="BalanceTrendCanvas" Grid.Row="2" Height="270" Margin="4,6,4,26"
                            Background="Transparent" Loaded="BalanceTrendCanvas_Loaded"
                            MouseMove="BalanceTrendCanvas_MouseMove" MouseLeave="BalanceTrendCanvas_MouseLeave"/>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>