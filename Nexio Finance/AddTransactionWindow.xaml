<Window x:Class="NexioFinance.Views.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Nexio_Finance.Properties"
        Title="{x:Static properties:Resources.WinAddTransactionTitle}" Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Background="#EFF6FF" ResizeMode="NoResize">

    <Grid Margin="18">
        <StackPanel>
            <!-- Barevný hlavičkový banner indikující režim (Modrá = Nový/Kopie, Žlutá = Úprava) -->
            <Border x:Name="HeaderBanner" Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HeaderIconBadge" Grid.Column="0" Background="#2563EB" CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderIconText" Text="＋" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleText" Text="{x:Static properties:Resources.AddRecord}" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hlavní karta formuláře pro zachování vysokého kontrastu vstupních polí -->
            <Border x:Name="FormCardBorder" Background="White" BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock Text="{x:Static properties:Resources.TransactionTypeLabel}" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="TypeComboBox" Margin="0,0,0,15" Padding="6" SelectionChanged="TypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Static properties:Resources.TypeExpense}" IsSelected="True"/>
                        <ComboBoxItem Content="{x:Static properties:Resources.TypeIncome}"/>
                        <ComboBoxItem Content="{x:Static properties:Resources.TypeTransfer}"/>
                    </ComboBox>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.15*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{x:Static properties:Resources.DateLabel}" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker x:Name="TransactionDatePicker" Padding="5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Static properties:Resources.AmountLabel}" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <!-- Kompozitní pole částky s pevným designovým znaménkem "−" pro výdaje -->
                            <Border x:Name="AmountInputBorder" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ExpenseMinusBadge" Grid.Column="0" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="0,0,1,0" Padding="10,0" Visibility="Visible">
                                        <TextBlock Text="−" Foreground="#DC2626" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBox x:Name="AmountTextBox" Grid.Column="1" Padding="6,5" BorderThickness="0" VerticalContentAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{x:Static properties:Resources.AccountFromLabel}" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="AccountComboBox" Margin="0,0,0,15" Padding="6" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="AccountComboBox_SelectionChanged"/>

                    <CheckBox x:Name="IsOwnTransferCheckBox" Content="{x:Static properties:Resources.OwnTransferCheck}" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,15" Visibility="Collapsed" Click="IsOwnTransferCheckBox_Click"/>

                    <StackPanel x:Name="TransferTargetPanel" Visibility="Collapsed" Margin="0,0,0,15">
                        <TextBlock Text="{x:Static properties:Resources.AccountToLabel}" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="TargetAccountComboBox" Padding="6" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="TargetAccountComboBox_SelectionChanged" Margin="0,0,0,15"/>

                        <StackPanel x:Name="ExchangeRatePanel" Visibility="Collapsed">
                            <TextBlock x:Name="ExchangeRateLabel" Text="{x:Static properties:Resources.ExchangeRateShort}" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="ExchangeRateTextBox" Padding="6"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="CategoryPanel">
                        <TextBlock x:Name="CategoryLabel" Text="{x:Static properties:Resources.CategoryLabel}" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CategoryComboBox" Margin="0,0,0,15" Padding="6" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                    </StackPanel>

                    <TextBlock Text="{x:Static properties:Resources.DescriptionLabel}" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="DescriptionTextBox" Margin="0,0,0,20" Padding="6" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{x:Static properties:Resources.BtnCancel}" Margin="0,0,8,0" Padding="10" Background="White" BorderBrush="#D1D5DB" FontWeight="SemiBold" Click="Cancel_Click"/>
                        <Button x:Name="SaveButton" Grid.Column="1" Content="{x:Static properties:Resources.BtnSaveTransaction}" Margin="8,0,0,0" Padding="10" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="Save_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>